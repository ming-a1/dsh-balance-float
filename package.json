{
  "name": "@lls-a1/dsh-balance-float",
  "version": "1.3.5",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Floating Web UI pill for DeepSeek API balance, today's spend and peak/off-peak pricing, plus a Volcengine Ark quota panel (account balance and Agent Plan / Coding Plan windows) signed locally with an AK/SK pair",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ming-a1/dsh-balance-float.git"
  },
  "homepage": "https://github.com/ming-a1/dsh-balance-float#readme",
  "bugs": {
    "url": "https://github.com/ming-a1/dsh-balance-float/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bundle",
    "balance",
    "usage",
    "peak",
    "widget",
    "volcengine",
    "ark",
    "quota",
    "agent-plan",
    "coding-plan"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  }
}
