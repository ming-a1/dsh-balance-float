{
  "name": "dsh-balance-float",
  "version": "1.1.30",
  "type": "module",
  "description": "Floating Web UI pill that reads the locally saved DeepSeek usage ledger: API balance, today's spend, and current peak/off-peak pricing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ming-a1/dsh-balance-float.git"
  },
  "homepage": "https://github.com/ming-a1/dsh-balance-float#readme",
  "bugs": {
    "url": "https://github.com/ming-a1/dsh-balance-float/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bundle",
    "balance",
    "usage",
    "peak",
    "widget"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
